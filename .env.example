# Copy this file to ".env" and fill in your keys. Never commit .env to GitHub.
# Stage 1 - OCR.space free key: https://ocr.space/ocrapi/freekey
OCR_SPACE_API_KEY=
# Stage 2 - Gemini free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional
# OCR_SPACE_ENGINE=2                 # 1, 2 or 3 (engine 2 is best for posters)
# GEMINI_MODEL=gemini-3.5-flash
# GEMINI_THINKING=low                # minimal | low | medium | high | default  (lower = faster)
# PORT=3000

# Optional prices (USD per 1M Gemini tokens) for cost estimates - from Google's Gemini pricing page
# PRICE_GEMINI_INPUT_PER_1M=
# PRICE_GEMINI_OUTPUT_PER_1M=
